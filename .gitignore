# Root .gitignore for AI Expense & Business Analytics SaaS

# Environment & Secrets
.env
.env.*
!.env.example
*.key

# PHP / Laravel
/backend/vendor/
/backend/bootstrap/cache/*.php
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/testing/*
/backend/storage/framework/views/*
/backend/storage/logs/*.log
/backend/.phpunit.result.cache

# Python / FastAPI / Analytics
/analytics-service/__pycache__/
/analytics-service/*/__pycache__/
/analytics-service/.venv/
/analytics-service/env/
/analytics-service/*.pyc
/analytics-service/.pytest_cache/

# Node / React Frontend
/frontend/node_modules/
/frontend/dist/
/frontend/build/
/frontend/.cache/

# IDE / OS Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
